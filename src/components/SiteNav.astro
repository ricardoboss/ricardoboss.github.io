---
const navItems = [
  { href: "/projects/", label: "Projects", paths: ["/", "/projects/", "/portfolio/"] },
  { href: "/cv/", label: "CV", paths: ["/cv/", "/curriculum-vitae/", "/resume/", "/résumé/"] },
  { href: "/uses/", label: "Uses", paths: ["/uses/"] },
  { href: "/contact/", label: "Contact", paths: ["/contact/"] },
]

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`
---

<nav class="site-nav" aria-label="Main navigation">
  {navItems.map((item) => (
    <a href={item.href} aria-current={item.paths.includes(currentPath) ? "page" : undefined}>
      {item.label}
    </a>
  ))}
</nav>
