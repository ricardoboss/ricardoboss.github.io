---
import type { Project } from "../types"
import Pill from "./Pill.astro"
import { externalLinkRel, externalLinkTarget } from "../utils/links"

interface Props {
  project: Project
}

const { project } = Astro.props
const projectPills = [
  ...project.languages.map((label) => ({ label, filter: "languages" })),
  ...project.frameworks.map((label) => ({ label, filter: "frameworks" })),
  ...project.platforms.map((label) => ({ label, filter: "platforms" })),
]

const sourceTitle = project.source === "open" ? "Open source" : "Closed source"
---

<article
  class="card project-card"
  data-project-card
  data-title={project.title.toLowerCase()}
  data-description={project.description.toLowerCase()}
  data-source={project.source}
  data-kind={project.kind}
  data-languages={project.languages.join("|").toLowerCase()}
  data-frameworks={project.frameworks.join("|").toLowerCase()}
  data-platforms={project.platforms.join("|").toLowerCase()}
>
  <div class="project-source-badge" title={sourceTitle} aria-label={sourceTitle}>
    {project.source === "open" ? (
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M8 12a4 4 0 0 0 4 4h2v-2h-2a2 2 0 0 1 0-4h2V8h-2a4 4 0 0 0-4 4Zm3 1h2v-2h-2v2Zm-7-1a8 8 0 0 1 8-8h2V2h-2a10 10 0 0 0 0 20h2v-2h-2a8 8 0 0 1-8-8Zm8-8h2v2h-2V4Zm0 14h2v2h-2v-2Zm4-14h-1v2h1a6 6 0 0 1 0 12h-1v2h1a8 8 0 0 0 0-16Z" />
      </svg>
    ) : (
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M7 10V8a5 5 0 0 1 10 0v2h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V8a3 3 0 0 0-6 0v2Zm3 4a2 2 0 0 0-1 3.73V19h2v-1.27A2 2 0 0 0 12 14Z" />
      </svg>
    )}
  </div>

  {project.image && (
    <img
      class="project-image"
      src={project.image}
      alt=""
      loading="lazy"
      style={`--image-padding: ${project.imagePadding ?? "1em"}`}
    />
  )}

  <div class="card-body">
    <p class="card-kicker">{project.kind}</p>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
  </div>

  {project.links && project.links.length > 0 && (
    <div class="card-links">
      {project.links.map((link) => (
        <a
          href={link.href}
          rel={externalLinkRel(link.href, link.rel)}
          target={externalLinkTarget(link.href)}
        >
          {link.label}
        </a>
      ))}
    </div>
  )}

  <div class="pills">
    {projectPills.map(({ label, filter }) => (
      <Pill label={label} interactive projectFilter={filter} />
    ))}
  </div>
</article>
