---
interface Props {
  to: string
  title?: string
}

const { to, title = "Redirecting" } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>{title}</title>
  </head>
  <body>
    <p><a href={to}>Continue</a></p>
    <script is:inline>
      location.replace(document.querySelector("a").href)
    </script>
  </body>
</html>
